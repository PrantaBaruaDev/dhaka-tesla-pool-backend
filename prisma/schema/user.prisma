model User {
    id           String   @id @default(uuid())
    name         String
    email        String   @unique
    passwordHash String   @map("password_hash")
    role         Role
    createdAt    DateTime @default(now()) @map("created_at")

    tesla         Tesla?
    rideRequests  RideRequest[]
    statusChanges RideStatusHistory[] @relation("ChangedBy")

    @@map("users")
}
